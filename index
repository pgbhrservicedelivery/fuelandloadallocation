<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Primary — Fuel & Load Allocation</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#f4f1ec;--white:#fff;--border:#e2ddd6;--border2:#ccc8c0;--ink:#0f0e0c;--ink2:#3d3a34;--ink3:#7a7570;--ink4:#b0aba4;--fuel:#1a3f7a;--fuel2:#2a5fc0;--fuel-bg:#eaf0fc;--load:#155c2a;--load2:#229944;--load-bg:#e8f5ec;--accent:#c84a0a;--accent2:#e05a18;--accent-bg:#fdeee7;--gold:#9a7a1a;--gold-bg:#fdf5e0;--r:10px;--r2:16px;--r3:24px;--sh:0 1px 3px rgba(0,0,0,.06),0 4px 12px rgba(0,0,0,.04);--sh2:0 8px 32px rgba(0,0,0,.1)}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.6;min-height:100vh}
#login-overlay{position:fixed;inset:0;z-index:9999;background:var(--ink);display:flex;align-items:center;justify-content:center;padding:1rem;overflow-y:auto}
#login-box{width:100%;max-width:400px;background:var(--white);border-radius:var(--r3);overflow:hidden;box-shadow:var(--sh2)}
#login-head{background:var(--ink);padding:2.5rem 2rem 2rem;text-align:center}
#login-mark{width:52px;height:52px;border-radius:13px;background:var(--accent);margin:0 auto .9rem;display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-size:20px;font-weight:800;color:#fff}
#login-ttl{font-family:'Syne',sans-serif;font-size:17px;font-weight:800;color:#fff;letter-spacing:-.02em}
#login-sub{font-size:12px;color:rgba(255,255,255,.4);margin-top:3px}
#login-body{padding:1.75rem}
.f-lbl{display:block;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-bottom:5px;margin-top:1rem}
.f-lbl:first-of-type{margin-top:0}
.f-inp{width:100%;padding:10px 13px;border:1.5px solid var(--border2);border-radius:8px;font-size:13px;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--bg);outline:none}
.f-inp:focus{border-color:var(--fuel2);background:var(--white)}
#login-err{display:none;background:#fef2f2;border:1px solid #fcc;color:#c00;border-radius:7px;padding:9px 12px;font-size:12px;font-weight:500;margin-bottom:.75rem}
#login-btn{width:100%;margin-top:1.25rem;padding:12px;border:none;border-radius:8px;background:var(--ink);color:#fff;font-size:13px;font-weight:700;font-family:'DM Sans',sans-serif;cursor:pointer}
#login-btn:hover{background:var(--accent)}
#quick-wrap{margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid var(--border)}
#quick-lbl{text-align:center;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink4);margin-bottom:10px}
.ql{display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:9px;border:1.5px solid var(--border);background:var(--bg);cursor:pointer;margin-bottom:8px;transition:all .15s}
.ql:hover{border-color:var(--ink);background:var(--white);transform:translateY(-1px)}
.ql-av{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.ql-n{font-size:13px;font-weight:700;color:var(--ink)}
.ql-r{font-size:11px;color:var(--ink3);margin-top:1px}
.ql-ar{margin-left:auto;font-size:15px;color:var(--ink4)}
nav{position:sticky;top:0;z-index:200;background:var(--ink);height:60px;display:flex;align-items:center;padding:0 1.5rem;gap:1rem}
.nav-logo{display:flex;align-items:center;gap:10px;margin-right:auto}
.nav-mark{width:30px;height:30px;border-radius:7px;background:var(--accent);display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-size:13px;font-weight:800;color:#fff}
.nav-name{font-family:'Syne',sans-serif;font-size:14px;font-weight:700;color:#fff}
.nav-name small{color:rgba(255,255,255,.35);font-weight:400;font-size:12px;margin-left:4px}
.nav-tabs{display:flex;gap:2px}
.ntab{padding:6px 13px;border-radius:7px;border:none;background:transparent;color:rgba(255,255,255,.5);font-size:13px;font-weight:500;font-family:'DM Sans',sans-serif;cursor:pointer;transition:all .15s}
.ntab:hover{color:#fff;background:rgba(255,255,255,.08)}
.ntab.on{color:#fff;background:rgba(255,255,255,.14)}
.ntab.admin-tab{display:none}
body.is-admin .ntab.admin-tab{display:block}
.nav-user{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:7px;padding:5px 10px}
.nav-av{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0}
.nav-uname{font-size:12px;font-weight:600;color:rgba(255,255,255,.85)}
.nav-urole{font-size:10px;color:rgba(255,255,255,.4)}
.nav-signout{padding:5px 10px;border-radius:6px;border:1px solid rgba(255,255,255,.15);background:transparent;color:rgba(255,255,255,.55);font-size:12px;font-family:'DM Sans',sans-serif;cursor:pointer}
.nav-signout:hover{background:rgba(255,255,255,.1);color:#fff}
.nav-upload{padding:6px 12px;border-radius:7px;border:1px solid rgba(255,255,255,.2);background:transparent;color:rgba(255,255,255,.7);font-size:12px;font-weight:600;font-family:'DM Sans',sans-serif;cursor:pointer;display:none}
body.is-admin .nav-upload{display:block}
.hero{background:var(--ink);padding:2.5rem 1.5rem 2rem;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 80% at 75% 50%,rgba(26,63,122,.5),transparent 70%);pointer-events:none}
.hero-in{max-width:1300px;margin:0 auto;position:relative}
.hero-pill{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);padding:4px 10px;border-radius:20px;margin-bottom:1rem}
.hero-dot{width:6px;height:6px;border-radius:50%;background:var(--load2);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}
.hero-pill span{font-size:10px;font-weight:700;color:rgba(255,255,255,.55);letter-spacing:.08em;text-transform:uppercase}
.hero-ttl{font-family:'Syne',sans-serif;font-size:clamp(22px,3.5vw,38px);font-weight:800;color:#fff;line-height:1.12;letter-spacing:-.02em;margin-bottom:.75rem}
.hero-ttl em{color:var(--accent2);font-style:normal}
.hero-sub{font-size:13px;color:rgba(255,255,255,.45);max-width:480px;margin-bottom:1.75rem}
.hero-kpis{display:flex;gap:1rem;flex-wrap:wrap}
.hkpi{padding:.65rem 1.1rem;border-radius:var(--r);border:1px solid rgba(255,255,255,.1)}
.hkpi.hk-fuel{background:rgba(26,63,122,.3);border-color:rgba(42,95,192,.4)}
.hkpi.hk-load{background:rgba(21,92,42,.3);border-color:rgba(34,153,68,.4)}
.hkpi.hk-n{background:rgba(255,255,255,.05)}
.hkpi-v{font-family:'Syne',sans-serif;font-size:19px;font-weight:700;color:#fff;letter-spacing:-.02em}
.hkpi-l{font-size:10px;color:rgba(255,255,255,.4);letter-spacing:.06em;text-transform:uppercase;margin-top:2px}
.pg{display:none}.pg.on{display:block}
.wrap{max-width:1300px;margin:0 auto;padding:1.75rem 1.5rem 3rem}
.sec-lbl{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);margin-bottom:.5rem}
.sec-ttl{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;color:var(--ink);margin-bottom:1.25rem;letter-spacing:-.01em}
.upload-zone{background:var(--white);border:2px dashed var(--border2);border-radius:var(--r2);padding:2rem;text-align:center;cursor:pointer;transition:all .18s;margin-bottom:1.5rem;display:none}
body.is-admin .upload-zone{display:block}
.upload-zone.drag{border-color:var(--accent);background:var(--accent-bg)}
.stage-bar{display:none;background:var(--white);border:2px solid var(--gold);border-radius:var(--r2);padding:1rem 1.25rem;margin-bottom:1.5rem;gap:12px;flex-wrap:wrap;align-items:center}
.stage-bar.active{display:flex}
.stage-icon{font-size:1.4rem;flex-shrink:0}
.stage-info{flex:1;min-width:180px}
.stage-ttl{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--gold);margin-bottom:2px}
.stage-sub{font-size:12px;color:var(--ink3)}
.stage-acts{display:flex;gap:8px;flex-shrink:0}
.btn-save{background:var(--load);color:#fff;border-color:var(--load)}
.btn-save:hover{background:var(--load2)}
.btn-discard{background:var(--white);color:var(--accent);border-color:var(--accent)}
.btn-discard:hover{background:var(--accent-bg)}
.uz-idle .uz-icon{font-size:2rem;margin-bottom:.5rem}
.uz-idle .uz-ttl{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;color:var(--ink);margin-bottom:.25rem}
.uz-idle .uz-sub{font-size:12px;color:var(--ink3)}
.uz-loaded{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px}
.uz-pills{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.upill{display:inline-flex;align-items:center;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600}
.upill-f{background:var(--fuel-bg);color:var(--fuel)}.upill-l{background:var(--load-bg);color:var(--load)}.upill-t{background:var(--bg);border:1px solid var(--border2);color:var(--ink3)}.upill-fn{background:var(--gold-bg);color:var(--gold)}
.btn{padding:7px 14px;border-radius:8px;font-size:12px;font-weight:600;font-family:'DM Sans',sans-serif;cursor:pointer;border:1px solid transparent;display:inline-flex;align-items:center;gap:5px;transition:all .15s}
.btn-ink{background:var(--ink);color:#fff}.btn-out{background:var(--white);color:var(--ink);border-color:var(--border2)}.btn-out:hover{background:var(--bg)}
.btn-fuel{background:var(--fuel);color:#fff}.btn-load{background:var(--load);color:#fff}.btn-acc{background:var(--accent);color:#fff}
.btn-sm{padding:5px 10px;font-size:11px}
.cbar{display:flex;align-items:center;gap:8px;margin-bottom:1.25rem;flex-wrap:wrap}
.seg{display:flex;border:1px solid var(--border2);border-radius:8px;overflow:hidden;background:var(--white)}
.sgb{padding:6px 13px;font-size:12px;font-weight:500;font-family:'DM Sans',sans-serif;border:none;background:transparent;color:var(--ink3);cursor:pointer;transition:all .15s}
.sgb.on{background:var(--ink);color:#fff}
.srch-wrap{position:relative;flex:1;min-width:160px;max-width:300px}
.srch-ico{position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--ink4);font-size:13px;pointer-events:none}
.srch{width:100%;padding:7px 10px 7px 28px;border:1px solid var(--border2);border-radius:8px;font-size:12px;font-family:'DM Sans',sans-serif;background:var(--white);color:var(--ink);outline:none}
.fsel{padding:6px 10px;border:1px solid var(--border2);border-radius:8px;font-size:12px;font-family:'DM Sans',sans-serif;background:var(--white);color:var(--ink);cursor:pointer;outline:none}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:10px;margin-bottom:1.5rem}
.kpi{background:var(--white);border:1px solid var(--border);border-radius:var(--r2);padding:1rem 1.15rem;box-shadow:var(--sh);position:relative;overflow:hidden}
.kpi::after{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.kpi.kf::after{background:var(--fuel2)}.kpi.kl::after{background:var(--load2)}.kpi.ka::after{background:var(--border2)}
.kpi-lbl{font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--ink3);margin-bottom:.4rem}
.kpi-val{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;color:var(--ink);letter-spacing:-.02em}
.kpi-sub{font-size:11px;color:var(--ink3);margin-top:3px}
.aff-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:9px;margin-bottom:1.5rem}
.aff-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r2);padding:1rem 1.1rem;cursor:pointer;transition:all .15s;box-shadow:var(--sh)}
.aff-card:hover{transform:translateY(-2px);box-shadow:var(--sh2)}
.aff-card.sel-f{border-color:var(--fuel2);background:var(--fuel-bg)}.aff-card.sel-l{border-color:var(--load2);background:var(--load-bg)}
.aff-n{font-family:'Syne',sans-serif;font-size:12px;font-weight:700;color:var(--ink);margin-bottom:5px}
.aff-chips{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px}
.chip{font-size:9px;padding:2px 5px;border-radius:9px;font-weight:700}
.chip-f{background:var(--fuel-bg);color:var(--fuel)}.chip-l{background:var(--load-bg);color:var(--load)}
.aff-amt{font-family:'DM Mono',monospace;font-size:14px;font-weight:500;color:var(--ink)}
.aff-pct{font-size:10px;color:var(--ink3);margin-top:1px}
.aff-bar{height:3px;background:var(--border);border-radius:2px;margin-top:7px;overflow:hidden}
.aff-bar-f{height:100%;border-radius:2px}
.an-panel{background:var(--white);border:1.5px solid var(--fuel2);border-radius:var(--r2);padding:1.25rem 1.5rem;margin-bottom:1.5rem;animation:slideIn .2s ease}
@keyframes slideIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
.an-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;gap:10px}
.an-ttl{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;color:var(--ink)}
.an-sub{font-size:11px;color:var(--ink3);margin-top:2px}
.an-close{padding:5px 10px;border-radius:6px;border:1px solid var(--border2);background:var(--bg);color:var(--ink3);font-size:11px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif}
.an-close:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
.an-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin-bottom:.9rem}
.an-kpi{background:var(--bg);border-radius:var(--r);padding:.75rem 1rem}
.an-kpi.akf{border-left:3px solid var(--fuel2)}.an-kpi.akl{border-left:3px solid var(--load2)}.an-kpi.akn{border-left:3px solid var(--border2)}
.an-kpi-l{font-size:9px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--ink3);margin-bottom:3px}
.an-kpi-v{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;color:var(--ink)}
.an-kpi-s{font-size:10px;color:var(--ink3);margin-top:2px}
.an-insight{background:linear-gradient(135deg,var(--fuel-bg),var(--load-bg));border:1px solid var(--border);border-radius:var(--r);padding:.9rem 1.1rem;font-size:12px;color:var(--ink2);line-height:1.7}
.an-insight strong{color:var(--ink);font-weight:700}
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:1.5rem}
@media(max-width:720px){.chart-grid{grid-template-columns:1fr}}
.chart-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r2);padding:1.2rem 1.35rem;box-shadow:var(--sh)}
.chart-card.full{grid-column:1/-1}
.chart-hd{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:.9rem}
.chart-hd em{font-style:normal;font-weight:400;font-size:12px;color:var(--ink3);margin-left:5px}
.bar-r{display:flex;align-items:center;gap:7px;margin-bottom:7px}
.bar-lbl{font-size:11px;color:var(--ink3);width:52px;text-align:right;flex-shrink:0;font-family:'DM Mono',monospace}
.bar-tr{flex:1;height:20px;background:var(--bg);border-radius:4px;overflow:hidden}
.bar-fl{height:100%;border-radius:4px;display:flex;align-items:center;padding-left:7px;font-size:10px;font-weight:600;color:rgba(255,255,255,.9);min-width:2px;font-family:'DM Mono',monospace}
.bar-vl{font-size:10px;color:var(--ink3);width:58px;text-align:right;font-family:'DM Mono',monospace}
.pct-r{display:flex;align-items:center;gap:7px;margin-bottom:6px}
.pct-tr{flex:1;height:14px;background:var(--bg);border-radius:4px;overflow:hidden}
.pct-fl{height:100%;border-radius:4px}
.pct-vl{font-size:10px;color:var(--ink3);width:34px;text-align:right;font-family:'DM Mono',monospace}
.avg-lg{display:flex;gap:14px;margin-bottom:.9rem;font-size:11px;color:var(--ink3)}
.avg-lg span{display:flex;align-items:center;gap:4px}
.lg-dot{width:9px;height:9px;border-radius:2px}
.tbl-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r2);box-shadow:var(--sh);overflow:hidden;margin-bottom:1.5rem}
.tbl-top{display:flex;align-items:center;justify-content:space-between;padding:.9rem 1.2rem;border-bottom:1px solid var(--border);background:var(--bg);flex-wrap:wrap;gap:8px}
.tbl-ttl{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--ink)}
.tbl-scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:12px}
thead th{padding:9px 12px;text-align:left;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink3);border-bottom:1px solid var(--border);background:var(--bg);white-space:nowrap}
tbody td{padding:9px 12px;border-bottom:1px solid var(--border);color:var(--ink);vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:#faf8f5}
.td-name{font-weight:700;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-transform:uppercase}
.td-dim{max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink3);font-size:11px}
.td-amt{font-family:'DM Mono',monospace;font-weight:500;text-align:right}
.td-none{text-align:right;color:var(--ink4);font-size:11px}
.badge{display:inline-flex;padding:2px 7px;border-radius:10px;font-size:10px;font-weight:700}
.badge-f{background:var(--fuel-bg);color:var(--fuel)}.badge-l{background:var(--load-bg);color:var(--load)}
.fuel-col{color:var(--fuel);font-family:'DM Mono',monospace;font-weight:600;text-align:right}
.load-col{color:var(--load);font-family:'DM Mono',monospace;font-weight:600;text-align:right}
.pagi{display:flex;align-items:center;justify-content:space-between;padding:.7rem 1.2rem;border-top:1px solid var(--border);background:var(--bg);flex-wrap:wrap;gap:6px}
.pagi-info{font-size:11px;color:var(--ink3);font-family:'DM Mono',monospace}
.pagi-btns{display:flex;gap:3px}
.pg-btn{padding:4px 9px;border:1px solid var(--border2);border-radius:5px;background:var(--white);color:var(--ink);font-size:11px;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .12s}
.pg-btn:hover:not([disabled]){background:var(--ink);color:#fff}
.pg-btn[disabled]{opacity:.35;cursor:default}
.pg-btn.cur{background:var(--ink);color:#fff}
.exp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:1.5rem}
.exp-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r2);padding:1.4rem;box-shadow:var(--sh)}
.exp-ico{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:.9rem}
.exp-ttl{font-family:'Syne',sans-serif;font-size:14px;font-weight:700;color:var(--ink);margin-bottom:.35rem}
.exp-desc{font-size:11px;color:var(--ink3);line-height:1.65;margin-bottom:1.1rem}
.mgr-act-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-bottom:1.5rem}
.mgr-act{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r2);padding:1.25rem;cursor:pointer;transition:all .15s;box-shadow:var(--sh)}
.mgr-act:hover{border-color:var(--ink);transform:translateY(-1px);box-shadow:var(--sh2)}
.mgr-act-ico{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:.8rem}
.mgr-act-ttl{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:.3rem}
.mgr-act-desc{font-size:11px;color:var(--ink3);line-height:1.6}
.log-bar{display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem;flex-wrap:wrap;gap:6px}
