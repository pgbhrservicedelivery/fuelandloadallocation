  var fa=fr.length?ft/fr.length:0,la=lr.length?lt/lr.length:0;
  var allFt=0,allLt=0;for(var i=0;i<D.length;i++){if(D[i].type==='Fuel')allFt+=D[i].amount;else allLt+=D[i].amount;}
