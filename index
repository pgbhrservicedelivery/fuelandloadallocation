function doLogout(){
  var ov=document.getElementById('login-overlay');
  document.getElementById('inp-u').value='';document.getElementById('inp-p').value='';
  document.getElementById('login-err').style.display='none';
  ov.style.display='flex';ov.style.opacity='0';
  setTimeout(function(){ov.style.transition='opacity .3s';ov.style.opacity='1';},10);
  document.body.classList.remove('is-admin');
  toast('Signed out');
}

window.addEventListener('load',function(){
  // Restore previously uploaded data from localStorage
  try{
    var saved=localStorage.getItem('fla_data');
    if(saved){var parsed=JSON.parse(saved);if(parsed&&parsed.length){D=parsed;setUploadUI('(restored data · '+D.length+' records)');}}
  }catch(ex){}
  document.getElementById('ql-admin').addEventListener('click',function(){quickLogin('HR SD Admin','12345@');});
  document.getElementById('ql-emp').addEventListener('click',function(){quickLogin('Employee','12345');});
  document.getElementById('inp-u').addEventListener('keydown',function(e){if(e.key==='Enter')document.getElementById('inp-p').focus();});
  document.getElementById('inp-p').addEventListener('keydown',function(e){if(e.key==='Enter')doLogin();});
  setupUpload();
  setUploadUI('preloaded-data.xlsx');
  renderAll();
  document.getElementById('inp-u').focus();
});

function toTitle(s){if(!s)return '';return s.toLowerCase().replace(/\b\w/g,function(c){return c.toUpperCase();});}

