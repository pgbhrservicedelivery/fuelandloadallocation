function renderPagi(infoId,btnsId,total,pages,cur,cb){
  var lo=Math.min(cur*PG+1,total),hi=Math.min((cur+1)*PG,total);
  document.getElementById(infoId).textContent=lo+'-'+hi+' of '+total.toLocaleString();
  var h='<button class="pg-btn" '+(cur===0?'disabled':'')+' onclick="('+cb+')('+(cur-1)+')">&#8592; Prev</button>';
  for(var i=0;i<pages;i++){if(pages<=7||Math.abs(i-cur)<=1||i===0||i===pages-1)h+='<button class="pg-btn'+(i===cur?' cur':'')+'" onclick="('+cb+')('+i+')">'+(i+1)+'</button>';else if(Math.abs(i-cur)===2)h+='<span style="padding:0 3px;color:var(--ink4)">&hellip;</span>';}
  h+='<button class="pg-btn" '+(cur>=pages-1?'disabled':'')+' onclick="('+cb+')('+(cur+1)+')">Next &#8594;</button>';
  document.getElementById(btnsId).innerHTML=h;
}

function updSub(){var t=document.getElementById('m-type').value;var sel=document.getElementById('m-sub');var lbl=document.getElementById('m-sub-lbl');if(t==='Fuel'){sel.innerHTML='<option value="Fleet card">Fleet Card</option><option value="Fuel allocation">Fuel Allocation</option>';lbl.innerHTML='Fuel Sub-type <span class="req">*</span>';}else{sel.innerHTML='<option value="LOAD ALLOCATION">Load Allocation</option><option value="GLOBE">Globe</option><option value="SMART">Smart</option>';lbl.innerHTML='Load Sub-type <span class="req">*</span>';}}
function openAdd(){editIdx=null;document.getElementById('mod-ttl').textContent='Add New Allocation';document.getElementById('mod-desc').textContent='Fill in all required fields.';document.getElementById('mod-save').textContent='Add Record';['m-empid','m-name','m-co','m-dept','m-desig','m-amt','m-rem'].forEach(function(id){document.getElementById(id).value='';});document.getElementById('m-type').value='Fuel';updSub();document.getElementById('mod-err').style.display='none';var cos=[];for(var i=0;i<D.length;i++){if(cos.indexOf(D[i].company)<0)cos.push(D[i].company);}cos.sort();document.getElementById('m-co-list').innerHTML=cos.map(function(c){return '<option value="'+c+'">';}).join('');document.getElementById('mod-edit').classList.add('open');setTimeout(function(){document.getElementById('m-empid').focus();},100);}
function openEdit(idx){editIdx=idx;var r=D[idx];document.getElementById('mod-ttl').textContent='Edit Allocation';document.getElementById('mod-desc').textContent='Updating: '+r.name;document.getElementById('mod-save').textContent='Save Changes';document.getElementById('m-empid').value=r.emp_id||'';document.getElementById('m-name').value=r.name;document.getElementById('m-co').value=r.company;document.getElementById('m-dept').value=r.dept||'';document.getElementById('m-desig').value=r.designation||'';document.getElementById('m-type').value=r.type;updSub();document.getElementById('m-sub').value=r.type==='Fuel'?(r.fuel_type||'Fleet card'):(r.load_type||'LOAD ALLOCATION');document.getElementById('m-amt').value=r.amount;document.getElementById('m-rem').value=r.remarks||'';document.getElementById('mod-err').style.display='none';var cos=[];for(var i=0;i<D.length;i++){if(cos.indexOf(D[i].company)<0)cos.push(D[i].company);}cos.sort();document.getElementById('m-co-list').innerHTML=cos.map(function(c){return '<option value="'+c+'">';}).join('');document.getElementById('mod-edit').classList.add('open');setTimeout(function(){document.getElementById('m-amt').focus();},100);}
function saveRec(){var empid=document.getElementById('m-empid').value.trim();var nm=document.getElementById('m-name').value.trim().toUpperCase();var co=document.getElementById('m-co').value.trim().toUpperCase();var dept=document.getElementById('m-dept').value.trim();var desig=document.getElementById('m-desig').value.trim();var typ=document.getElementById('m-type').value;var sub=document.getElementById('m-sub').value;var amt=parseFloat(document.getElementById('m-amt').value);var rem=document.getElementById('m-rem').value.trim();var err=document.getElementById('mod-err');var errs=[];if(!nm)errs.push('Name required.');if(!co)errs.push('Affiliate required.');if(isNaN(amt)||amt<=0)errs.push('Valid amount required.');if(errs.length){err.textContent=errs.join(' ');err.style.display='block';return;}err.style.display='none';var t=nowT();if(editIdx===null){D.push({emp_id:empid,company:co,name:nm,dept:dept,designation:desig,amount:amt,fuel_type:typ==='Fuel'?sub:'',load_type:typ==='Load'?sub:'',remarks:rem,type:typ});addLog('add','Added <strong>'+nm+'</strong>'+(empid?' ['+empid+']':'')+' ('+co+') '+typ+' '+sub+' '+P(amt)+'.',t);toast('Added: '+nm);}else{var old=D[editIdx];D[editIdx]={emp_id:empid,company:co,name:nm,dept:dept,designation:desig,amount:amt,fuel_type:typ==='Fuel'?sub:'',load_type:typ==='Load'?sub:'',remarks:rem,type:typ};addLog('edit','Edited <strong>'+nm+'</strong>'+(empid?' ['+empid+']':'')+' amount '+P(old.amount)+' to '+P(amt)+'.',t);toast('Updated: '+nm);}closeMod('mod-edit');try{localStorage.setItem('fla_data',JSON.stringify(D));}catch(ex){}renderAll();}
function openSep(idx){sepIdx=idx;var r=D[idx];document.getElementById('sep-desc').innerHTML='Remove <strong>'+r.name+'</strong> ('+r.company+' — '+r.type+' '+P(r.amount)+')? Logged.';document.getElementById('mod-sep').classList.add('open');}
function confirmSep(){if(sepIdx===null)return;var r=D[sepIdx];var snapshot=JSON.parse(JSON.stringify(r));addLog('sep','Separated <strong>'+toTitle(r.name)+'</strong>'+(r.emp_id?' ['+r.emp_id+']':'')+' ('+r.company+') '+r.type+' '+P(r.amount)+' removed.',nowT(),snapshot);D.splice(sepIdx,1);try{localStorage.setItem('fla_data',JSON.stringify(D));}catch(ex){}sepIdx=null;toast('Separated.');closeMod('mod-sep');renderAll();}
function closeMod(id){document.getElementById(id).classList.remove('open');}
document.getElementById('mod-edit').addEventListener('click',function(e){if(e.target===e.currentTarget)closeMod('mod-edit');});
document.getElementById('mod-sep').addEventListener('click',function(e){if(e.target===e.currentTarget)closeMod('mod-sep');});
function addLog(type,txt,t,snapshot){logs.unshift({type:type,txt:txt,t:t,snapshot:snapshot||null});try{localStorage.setItem('fla_changelog',JSON.stringify(logs));}catch(e){}renderLog();}
function clearLog(){if(!confirm('Clear all change log entries? This cannot be undone.'))return;logs=[];try{localStorage.removeItem('fla_changelog');}catch(e){}renderLog();toast('Change log cleared.');}
function recoverSep(idx){var l=logs[idx];if(!l||!l.snapshot)return;if(!confirm('Recover this allocation for '+toTitle(l.snapshot.name)+'?'))return;D.push(l.snapshot);try{localStorage.setItem('fla_data',JSON.stringify(D));}catch(ex){}addLog('edit','Recovered <strong>'+toTitle(l.snapshot.name)+'</strong>'+(l.snapshot.emp_id?' ['+l.snapshot.emp_id+']':'')+' ('+l.snapshot.company+') '+l.snapshot.type+' '+P(l.snapshot.amount)+'.',nowT());toast('Recovered: '+toTitle(l.snapshot.name));renderAll();}
function renderLog(){document.getElementById('log-ct').textContent=logs.length+' change'+(logs.length!==1?'s':'');if(!logs.length){document.getElementById('log-list').innerHTML='<div style="color:var(--ink3);font-size:12px;padding:8px 0">No changes yet.</div>';return;}var h='';for(var i=0;i<logs.length;i++){var l=logs[i];var recoverBtn=l.type==='sep'&&l.snapshot?'<button onclick="recoverSep('+i+')" style="margin-left:8px;font-size:10px;padding:2px 8px;border-radius:6px;border:1px solid var(--load2);color:var(--load2);background:var(--load-bg);cursor:pointer;font-weight:600;flex-shrink:0">&#8635; Recover</button>':'';h+='<div class="log-entry log-'+l.type+'" style="align-items:center"><span class="log-time">'+l.t+'</span><span class="log-txt" style="flex:1">'+l.txt+'</span>'+recoverBtn+'<span class="log-badge lb-'+l.type+'">'+(l.type==='add'?'Added':l.type==='edit'?'Edited':'Separated')+'</span></div>';}document.getElementById('log-list').innerHTML=h;}
function dlCSV(data,fn){var hdrs=['ID No.','Company','Name','Dept','Designation','Type','Fuel Type','Load Type','Amount','Remarks'];var rows=[hdrs];for(var i=0;i<data.length;i++){var r=data[i];rows.push([r.emp_id||'',r.company,r.name,r.dept,r.designation,r.type,r.fuel_type||'',r.load_type||'',r.amount,r.remarks||'']);}var csv=rows.map(function(r){return r.map(function(v){return '"'+String(v).replace(/"/g,'""')+'"';}).join(',');}).join('\n');var a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);a.download=fn;a.click();}
function expAllCSV(){dlCSV(D,'primary_allocation.csv');toast('CSV downloaded');}
function expFilteredCSV(){dlCSV(filtD(),'primary_allocation_filtered.csv');toast('Filtered CSV downloaded');}
function expEmpCSV(){
  var am=getAM(D);var filtered=filtE();
  var empMap={};var empOrder=[];
  for(var i=0;i<filtered.length;i++){var r=filtered[i];var key=r.company+'|||'+r.name;if(!empMap[key]){empMap[key]={name:r.name,company:r.company,dept:r.dept,designation:r.designation,fleet:0,fuelAlloc:0,loadAlloc:0,smart:0,globe:0};empOrder.push(key);}var e=empMap[key];if(r.type==='Fuel'){var ft=(r.fuel_type||'').toLowerCase();if(ft==='fleet card')e.fleet+=r.amount;else e.fuelAlloc+=r.amount;}else{var lt=(r.load_type||'').toUpperCase();if(lt==='SMART')e.smart+=r.amount;else if(lt==='GLOBE')e.globe+=r.amount;else e.loadAlloc+=r.amount;}}
  empOrder.sort(function(a,b){var ea=empMap[a],eb=empMap[b];return ea.company.localeCompare(eb.company)||ea.name.localeCompare(eb.name);});
  var hdrs=['ID No.','Company','Name','Dept','Designation','Fleet Card','Fuel Allocation','Load Allocation','Smart','Globe','Total','% of Affiliate'];
  var rows=[hdrs];
  for(var i=0;i<empOrder.length;i++){var e=empMap[empOrder[i]];var tot=e.fleet+e.fuelAlloc+e.loadAlloc+e.smart+e.globe;var at=(am[e.company]?am[e.company].fuel+am[e.company].load:0);var pct=at>0?+(tot/at*100).toFixed(2):0;rows.push([e.emp_id||'',e.company,e.name,e.dept,e.designation,e.fleet||'',e.fuelAlloc||'',e.loadAlloc||'',e.smart||'',e.globe||'',tot,pct]);}
  var csv=rows.map(function(r){return r.map(function(v){return '"'+String(v).replace(/"/g,'""')+'"';}).join(',');}).join('\n');
  var a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);a.download='primary_employees.csv';a.click();toast('Employee CSV downloaded');
}
function expAllExcel(){var wb=XLSX.utils.book_new();var hdrs=['ID No.','Company','Name','Dept','Designation','Type','Fuel Type','Load Type','Amount','Remarks'];function toR(arr){return arr.map(function(r){return[r.emp_id||'',r.company,r.name,r.dept,r.designation,r.type,r.fuel_type||'',r.load_type||'',r.amount,r.remarks||''];});}var fr=D.filter(function(r){return r.type==='Fuel';}),lr=D.filter(function(r){return r.type==='Load';});XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([hdrs].concat(toR(fr))),'Fuel');XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([hdrs].concat(toR(lr))),'Load');XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([hdrs].concat(toR(D))),'All Records');XLSX.writeFile(wb,'primary_allocation_full.xlsx');toast('Excel downloaded');}
function expSummary(){var am=getAM(D);var allFt=0,allLt=0;for(var i=0;i<D.length;i++){if(D[i].type==='Fuel')allFt+=D[i].amount;else allLt+=D[i].amount;}var wb=XLSX.utils.book_new();var hdrs=['Affiliate','Fuel Recip','Fuel Total','Avg Fuel','Fuel %','Load Recip','Load Total','Avg Load','Load %'];var rows=[hdrs];var cos=Object.keys(am).sort();for(var i=0;i<cos.length;i++){var c=cos[i],v=am[c];rows.push([c,v.fc,v.fuel,v.fc?+(v.fuel/v.fc).toFixed(2):0,allFt>0?+(v.fuel/allFt*100).toFixed(2):0,v.lc,v.load,v.lc?+(v.load/v.lc).toFixed(2):0,allLt>0?+(v.load/allLt*100).toFixed(2):0]);}XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rows),'Summary');XLSX.writeFile(wb,'primary_summary.xlsx');toast('Summary downloaded');}
