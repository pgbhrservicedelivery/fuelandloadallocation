.modal-acts{display:flex;gap:8px;justify-content:flex-end;margin-top:1.25rem}
.toast{position:fixed;bottom:20px;right:20px;background:var(--ink);color:#fff;padding:10px 16px;border-radius:9px;font-size:12px;font-weight:500;box-shadow:var(--sh2);z-index:9998;opacity:0;transform:translateY(6px);transition:all .22s;pointer-events:none}
