    h+='<td>'+e.company+'</td>';
    h+='<td class="td-dim">'+(e.dept||'&mdash;')+'</td>';
    h+='<td class="td-dim">'+(e.designation||'&mdash;')+'</td>';
    h+='<td style="text-align:right;background:var(--fuel-bg)">'+fmtAmt(e.fleet)+'</td>';
    h+='<td style="text-align:right;background:var(--fuel-bg)">'+fmtAmt(e.fuelAlloc)+'</td>';
    h+='<td style="text-align:right;background:var(--load-bg)">'+fmtAmt(e.loadAlloc)+'</td>';
    h+='<td style="text-align:right;background:var(--load-bg)">'+fmtAmt(e.smart)+'</td>';
    h+='<td style="text-align:right;background:var(--load-bg)">'+fmtAmt(e.globe)+'</td>';
