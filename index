}

function renderMgr(){
  var cos=[];for(var i=0;i<D.length;i++){if(cos.indexOf(D[i].company)<0)cos.push(D[i].company);}cos.sort();
  var sel=document.getElementById('mgr-aff');var cur=sel.value;sel.innerHTML='<option value="">All affiliates</option>';for(var i=0;i<cos.length;i++)sel.innerHTML+='<option value="'+cos[i]+'"'+(cos[i]===cur?' selected':'')+'>'+cos[i]+'</option>';
  var recs=filtM().slice().sort(function(a,b){return a.company.localeCompare(b.company)||a.name.localeCompare(b.name);});
  var tot=recs.length,pgs=Math.max(1,Math.ceil(tot/PG));if(mpg>=pgs)mpg=pgs-1;
  document.getElementById('mgr-ttl').textContent=(maF||'All affiliates')+' — '+tot.toLocaleString()+' records';
  var h='';
  for(var i=mpg*PG;i<Math.min(recs.length,(mpg+1)*PG);i++){
    var r=recs[i];var di=D.indexOf(r);var sub=r.type==='Fuel'?(r.fuel_type||'Fleet card'):(r.load_type||'Load Allocation');var bc=r.type==='Fuel'?'badge-f':'badge-l';
    var idDisp=r.emp_id?r.emp_id:'&mdash;';
    var idSt=r.emp_id?"font-family:'DM Mono',monospace;font-size:11px;font-weight:600;color:var(--ink2)":"color:var(--ink4)";
    h+='<tr>';
    h+='<td style="'+idSt+'">'+idDisp+'</td>';
    h+='<td class="td-name">'+toTitle(r.name)+'</td>';
    h+='<td>'+r.company+'</td>';
    h+='<td class="td-dim">'+(r.dept||'&mdash;')+'</td>';
    h+='<td class="td-dim">'+(r.designation||'&mdash;')+'</td>';
    h+='<td><span class="badge '+bc+'">'+sub+'</span></td>';
    h+='<td class="td-amt">'+P(r.amount)+'</td>';
    h+='<td class="td-dim">'+(r.remarks||'&mdash;')+'</td>';
    h+='<td style="text-align:center"><div style="display:flex;gap:5px;justify-content:center"><button class="tbl-btn tbl-edit" onclick="openEdit('+di+')">&#9998; Edit</button><button class="tbl-btn tbl-sep" onclick="openSep('+di+')">&#10005; Sep</button></div></td>';
    h+='</tr>';
  }
  document.getElementById('tb-mgr').innerHTML=h||'<tr><td colspan="9" style="text-align:center;padding:2rem;color:var(--ink3)">No records found</td></tr>';
  renderPagi('pgi-mgr','pgb-mgr',tot,pgs,mpg,function(p){mpg=p;renderMgr();});
