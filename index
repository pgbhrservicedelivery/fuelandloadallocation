function getAM(arr){
  var m={};
  for(var i=0;i<arr.length;i++){
    var r=arr[i];
    if(!m[r.company])m[r.company]={fuel:0,load:0,fc:0,lc:0};
    if(r.type==='Fuel'){m[r.company].fuel+=r.amount;m[r.company].fc++;}
    else{m[r.company].load+=r.amount;m[r.company].lc++;}
  }
  return m;
}

function getUsers(){return [{u:'HR SD Admin',p:'12345@',role:'admin',display:'HR SD Admin'},{u:'Employee',p:'12345',role:'viewer',display:'Employee'}];}

function quickLogin(u,p){document.getElementById('inp-u').value=u;document.getElementById('inp-p').value=p;document.getElementById('login-err').style.display='none';setTimeout(doLogin,150);}

function doLogin(){
  var u=document.getElementById('inp-u').value.trim();
  var p=document.getElementById('inp-p').value;
  var err=document.getElementById('login-err');
  err.style.display='none';
  var users=getUsers();var match=null;
  for(var i=0;i<users.length;i++){if(users[i].u.toLowerCase()===u.toLowerCase()&&users[i].p===p){match=users[i];break;}}
  if(!match){err.textContent='Incorrect username or password.';err.style.display='block';document.getElementById('inp-p').value='';return;}
  var ov=document.getElementById('login-overlay');
  ov.style.transition='opacity .35s';ov.style.opacity='0';
  setTimeout(function(){ov.style.display='none';},360);
  document.getElementById('nav-av').textContent=match.display.split(' ').map(function(w){return w[0];}).slice(0,2).join('');
