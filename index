function expLog(){if(!logs.length){toast('No changes to export');return;}var rows=[['Time','Action','Details']];for(var i=0;i<logs.length;i++){rows.push([logs[i].t,logs[i].type.toUpperCase(),logs[i].txt.replace(/<[^>]+>/g,'')]);}var csv=rows.map(function(r){return r.map(function(v){return '"'+String(v).replace(/"/g,'""')+'"';}).join(',');}).join('\n');var a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(csv);a.download='change_log.csv';a.click();toast('Log exported');}
