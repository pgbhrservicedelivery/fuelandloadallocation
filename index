function lookupPGB(empId){
  if(!empId) return null;
  var key = String(empId).trim().toUpperCase();
  // 1. Exact match
  if(PGB_MASTER.map[key]) return PGB_MASTER.map[key];
  // 2. Normalized match (strip leading zeros from numeric part)
  var norm = key.replace(/^CE0*/,'CE').replace(/^0+/,'');
  if(PGB_MASTER.mapNorm[norm]) return PGB_MASTER.mapNorm[norm];
  // 3. Numeric-only: try padding to CE000XXX format
  if(/^\d+$/.test(key)){
    var padded = 'CE' + key.padStart(6,'0');
    if(PGB_MASTER.map[padded]) return PGB_MASTER.map[padded];
  }
  return null;
}

function procFiles(files){
  var nr=[];var pending=files.length;var fn=files.map(function(f){return f.name;}).join(', ');
  var matchedFromPGB=0;
  files.forEach(function(file){
    var reader=new FileReader();
    reader.onload=function(e){
      try{
        var wb=XLSX.read(new Uint8Array(e.target.result),{type:'array'});
        var fileIsFuel=/fuel/i.test(file.name);
        var fileIsLoad=/load/i.test(file.name);
        wb.SheetNames.forEach(function(sn){
          var ws=wb.Sheets[sn];
          var rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
          if(!rows.length)return;
          var hdrs=rows[0].map(function(h){return String(h).trim().toUpperCase();});
          // Determine fuel vs load: sheet name first, then filename hint, then headers
          var snUp=sn.trim().toUpperCase();
          var isFuel;
          if(snUp==='FUEL'||snUp==='FUEL ALLOCATION'||snUp==='FLEET CARD'||snUp==='FUEL DATA'){
            isFuel=true;
          } else if(snUp==='LOAD'||snUp==='LOAD ALLOCATION'||snUp==='SMART'||snUp==='GLOBE'||snUp==='LOAD DATA'){
            isFuel=false;
          } else if(fileIsFuel&&!fileIsLoad){
            isFuel=true;
          } else if(fileIsLoad&&!fileIsFuel){
            isFuel=false;
          } else {
            var hdrsStr=hdrs.join(' ');
            isFuel=hdrsStr.indexOf('FUEL')>=0||hdrsStr.indexOf('FLEET')>=0;
          }
          function gi(keys){for(var k=0;k<keys.length;k++){var ix=hdrs.indexOf(keys[k]);if(ix>=0)return ix;}return -1;}
          var idi=gi(['ID','ID NO','IDNO','ID NUMBER','EMP ID','EMPLOYEE ID']);
          var ci=gi(['COMPANY','AFFILIATE']);
          var ni=gi(['NAME','NAMES','COMPLETE NAME']);
          var di=gi(['DEPARTMENT','DEPT']);
          var desi=gi(['DESIGNATION','POSITION']);
          var ai=gi(['AMOUNT']);
          var fti=gi(['FUEL TYPE','FUEL_TYPE','TYPE','SUBTYPE']);
          var lti=gi(['TELCO','LOAD TYPE','LOAD_TYPE']);
          rows.slice(1).forEach(function(row){
            var rowCheck=row.join('').trim();
            if(!rowCheck)return;
            var empId=idi>=0?String(row[idi]||'').trim():'';
            // PGB lookup by ID only (name lookup removed — caused wrong affiliate mapping)
            var pgbMatch=empId?lookupPGB(empId):null;
            var nmRaw=ni>=0?String(row[ni]||'').trim():'';
            var co=pgbMatch?pgbMatch.affiliate:(ci>=0?String(row[ci]||'').trim():'');
            var nm=pgbMatch?pgbMatch.name.toUpperCase():nmRaw.toUpperCase();
            var dept=pgbMatch?pgbMatch.dept:(di>=0?String(row[di]||'').trim():'');
            var desig=pgbMatch?pgbMatch.position:(desi>=0?String(row[desi]||'').trim():'');
            var amtRaw=ai>=0?String(row[ai]||''):'';
            var amt=parseFloat(amtRaw.replace(/[^0-9.]/g,''));
            if(!nm||isNaN(amt)||amt<=0)return;
            if(pgbMatch)matchedFromPGB++;
            var resolvedId=empId||(pgbMatch?pgbMatch.id:'')||'';
            nr.push({
              emp_id:resolvedId,
              company:co||'N/A',
              name:nm,
              dept:dept,
              designation:desig,
              amount:amt,
              fuel_type:isFuel?(fti>=0&&row[fti]?String(row[fti]).trim():'Fleet card'):'',
              load_type:!isFuel?(lti>=0&&row[lti]?String(row[lti]).trim().toUpperCase():'LOAD ALLOCATION'):'',
              remarks:'',
              type:isFuel?'Fuel':'Load',
              pgb_verified:!!pgbMatch
            });
          });
        });
      }catch(err){toast('Error reading '+file.name+': '+err.message);}
      pending--;
      if(pending===0){
        if(nr.length>0){
          PENDING_DATA={records:nr,filename:fn,pgbMatched:matchedFromPGB};
          showStageBar(nr,fn,matchedFromPGB);
          toast('Preview ready — '+nr.length.toLocaleString()+' records. Click Save & Apply to update the dashboard.');
        }else{
          toast('No valid records found. Ensure your sheet has NAME and AMOUNT columns.');
        }
      }
    };
    reader.readAsArrayBuffer(file);
  });
}

